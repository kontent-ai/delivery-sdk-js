{
	"name": "@kontent-ai/delivery-sdk",
	"version": "17.0.0-preview.2",
	"repository": {
		"type": "git",
		"url": "https://github.com/kontent-ai/delivery-sdk-js"
	},
	"private": false,
	"author": "richard sustek",
	"license": "MIT",
	"description": "Official Kontent.AI Delivery API SDK",
	"keywords": [
		"Kontent",
		"Kontent.ai",
		"Kontent SDK",
		"Kontent API",
		"Kontent Delivery",
		"Kontent Javascript",
		"Kontent Node.js",
		"Kontent Typescript"
	],
	"engines": {
		"node": ">= 22"
	},
	"packageManager": "pnpm@12.11.2",
	"exports": {
		".": {
			"types": "./dist/public_api.d.ts",
			"default": "./dist/public_api.js"
		},
		"./schemas": {
			"types": "./dist/public_schemas.d.ts",
			"default": "./dist/public_schemas.js"
		}
	},
	"types": "./dist/public_api.d.ts",
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"prepublishOnly": "pnpm run build && pnpm run test",
		"build": "pnpm run lint && pnpm run clean && pnpm run build:ts && pnpm run update:version",
		"build:ts": "tsc -p tsconfig.build.json",
		"test": "vitest run --config=vitest.config.ts --coverage",
		"test:unit": "vitest run --config=vitest-unit.config.ts",
		"test:integration": "vitest run --config=vitest-integration.config.ts",
		"test:types": "tsc -p sample/tsconfig.json",
		"lint": "pnpm run biome:check && pnpm run oxlint",
		"oxlint": "oxlint --type-aware --type-check --deny-warnings lib tests scripts sample",
		"biome:check": "biome check",
		"biome:fix": "biome check --write",
		"biome:fix:unsafe": "biome check --write --unsafe",
		"clean": "tsx ./scripts/clean.ts",
		"update:version": "tsx ./scripts/update-version.ts",
		"bundle:size": "tsx scripts/measure-bundle.ts",
		"bundle:create": "tsx scripts/create-bundles.ts",
		"bump:patch": "pnpm run build && npm version patch -m \"v%s\" && pnpm run build:ts && git push --follow-tags",
		"bump:minor": "pnpm run build && npm version minor -m \"v%s\" && pnpm run build:ts && git push --follow-tags",
		"bump:major": "pnpm run build && npm version major -m \"v%s\" && pnpm run build:ts && git push --follow-tags"
	},
	"peerDependencies": {
		"@kontent-ai/core-sdk": "^12.0.0-preview.44",
		"ts-pattern": "^5",
		"zod": "^4"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@kontent-ai/biome-config": "0.7.3",
		"@types/node": "26.6.5",
		"@vitest/coverage-v8": "5.0.3",
		"esbuild": "0.28.2",
		"oxlint": "1.87.0",
		"oxlint-tsgolint": "7.0.2004",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"vitest": "5.0.3"
	}
}
